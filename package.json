{
  "name": "pumpsync-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('_site', { recursive: true, force: true })\"",
    "build": "npm run clean && eleventy",
    "start": "eleventy --serve --port 8766",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0"
  },
  "overrides": {
    "@11ty/recursive-copy": "5.0.2",
    "minimatch": "10.2.6",
    "brace-expansion": "5.0.8",
    "linkify-it": "5.0.2",
    "liquidjs": "10.27.1"
  }
}
